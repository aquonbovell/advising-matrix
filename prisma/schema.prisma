generator client {
  provider     = "prisma-kysely"
  output       = "../src/lib/server/db"
  fileName     = "app.schema.ts"
  enumFileName = "app.enums.ts"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

